# Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Database
DATABASE_URL=postgres://rho_studio:rho_studio@127.0.0.1:5432/rho_studio
DATABASE_MAX_CONNECTIONS=20

# Cache
REDIS_URL=redis://127.0.0.1:6379/

# Authentication
# Production: JWT_SECRET must be at least 32 random bytes, sourced from a secret manager.
JWT_SECRET=change-me-in-production
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=2592000

# CORS
# Production: explicit HTTPS origins, no wildcards. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=10
AUTH_REFRESH_RATE_LIMIT_ATTEMPTS=30

# Trusted proxies
# Production: set to the actual proxy/load-balancer CIDR ranges.
# Empty means no forwarded headers are trusted.
TRUSTED_PROXY_CIDRS=

# Object storage
STORAGE_BACKEND=rustfs
STORAGE_AUTO_CREATE_BUCKET=true
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=rho-studio-documents
S3_REGION=us-east-1

# Logging
RUST_LOG=info,rho_studio_fintech=debug,tower_http=debug